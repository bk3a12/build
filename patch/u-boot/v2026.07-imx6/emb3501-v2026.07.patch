+
+void board_init_f(ulong dummy)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(emb3501_init); i++)
+		writel(emb3501_init[i].value,
+		       (void __iomem *)(uintptr_t)emb3501_init[i].addr);
+
+	/* The factory table already sets CCGR and the IOMUXC GPRs. */
+	arch_cpu_init();
+
+	/* Keep the EMB3501 UART pinmux and common SPL handoff. */
+	board_early_init_f();
+	timer_init();
+	preloader_console_init();
+
+	memset(__bss_start, 0, __bss_end - __bss_start);
+	board_init_r(NULL, 0);
+}
