+#include <asm/gpio.h>
+#include <asm/io.h>
+#include <asm/mach-imx/boot_mode.h>
+#include <asm/sections.h>
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <spl.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+#define EMB3501_SD_CD IMX_GPIO_NR(7, 0)
+
+static const iomux_v3_cfg_t uart1_pads[] = {
+	IOMUX_PADS(PAD_SD3_DAT7__UART1_TX_DATA | MUX_PAD_CTRL(0x1b0b1)),
+	IOMUX_PADS(PAD_SD3_DAT6__UART1_RX_DATA | MUX_PAD_CTRL(0x1b0b1)),
+};
+
+int board_early_init_f(void)
+{
+	SETUP_IOMUX_PADS(uart1_pads);
+	return 0;
+}
+
+int dram_init(void)
+{
+	gd->ram_size = imx_ddr_size();
+	return 0;
+}
+
+int board_init(void)
+{
+	gd->bd->bi_boot_params = CFG_SYS_SDRAM_BASE + 0x100;
+	return 0;
+}
+
+#ifdef CONFIG_CMD_BMODE
+static const struct boot_mode emb3501_boot_modes[] = {
+	{ "sd3", MAKE_CFGVAL(0x40, 0x30, 0, 0) },
+	{ "emmc", MAKE_CFGVAL(0x60, 0x58, 0, 0) },
+	{ NULL, 0 },
+};
+#endif
+
+int board_late_init(void)
+{
+#ifdef CONFIG_CMD_BMODE
+	add_board_boot_modes(emb3501_boot_modes);
+#endif
+	return 0;
+}
+
+#ifdef CONFIG_XPL_BUILD
+/* USDHC3 uses DAT0-DAT3. DAT5 is card detect and DAT6/7 are UART1. */
+static const iomux_v3_cfg_t usdhc3_pads[] = {
+	IOMUX_PADS(PAD_SD3_CMD__SD3_CMD | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD3_CLK__SD3_CLK | MUX_PAD_CTRL(0x10059)),
+	IOMUX_PADS(PAD_SD3_DAT0__SD3_DATA0 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD3_DAT1__SD3_DATA1 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD3_DAT2__SD3_DATA2 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD3_DAT3__SD3_DATA3 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD3_DAT5__GPIO7_IO00 | MUX_PAD_CTRL(NO_PAD_CTRL)),
+};
+
+static const iomux_v3_cfg_t usdhc4_pads[] = {
+	IOMUX_PADS(PAD_SD4_CMD__SD4_CMD | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_CLK__SD4_CLK | MUX_PAD_CTRL(0x10059)),
+	IOMUX_PADS(PAD_SD4_DAT0__SD4_DATA0 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT1__SD4_DATA1 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT2__SD4_DATA2 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT3__SD4_DATA3 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT4__SD4_DATA4 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT5__SD4_DATA5 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT6__SD4_DATA6 | MUX_PAD_CTRL(0x17059)),
+	IOMUX_PADS(PAD_SD4_DAT7__SD4_DATA7 | MUX_PAD_CTRL(0x17059)),
+};
+
+static struct fsl_esdhc_cfg spl_usdhc;
+
+int board_mmc_getcd(struct mmc *mmc)
+{
+	if (spl_usdhc.esdhc_base == USDHC3_BASE_ADDR)
+		return !gpio_get_value(EMB3501_SD_CD);
+
+	return 1;
+}
+
+int board_mmc_init(struct bd_info *bis)
+{
+	u32 boot_cfg = imx6_src_get_boot_mode();
+
+	/* BOOT_CFG2[4:3] encodes the USDHC controller index. */
+	switch ((boot_cfg >> 11) & 3) {
+	case 2:
+		SETUP_IOMUX_PADS(usdhc3_pads);
+		gpio_direction_input(EMB3501_SD_CD);
+		spl_usdhc.esdhc_base = USDHC3_BASE_ADDR;
+		spl_usdhc.sdhc_clk = mxc_get_clock(MXC_ESDHC3_CLK);
+		spl_usdhc.max_bus_width = 4;
+		break;
+	case 3:
+		SETUP_IOMUX_PADS(usdhc4_pads);
+		spl_usdhc.esdhc_base = USDHC4_BASE_ADDR;
+		spl_usdhc.sdhc_clk = mxc_get_clock(MXC_ESDHC4_CLK);
+		spl_usdhc.max_bus_width = 8;
+		break;
+	default:
+		return -ENODEV;
+	}
+
+	gd->arch.sdhc_clk = spl_usdhc.sdhc_clk;
+	return fsl_esdhc_initialize(bis, &spl_usdhc);
+}
