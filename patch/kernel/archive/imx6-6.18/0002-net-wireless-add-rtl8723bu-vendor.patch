+//
+// ODM Timer relative API.
+//
+VOID
+ODM_StallExecution(
+	IN	u4Byte	usDelay
+	)
+{
+	rtw_udelay_os(usDelay);
+}
+
+VOID
+ODM_delay_ms(IN u4Byte	ms)
+{
+	rtw_mdelay_os(ms);
+}
+
+VOID
+ODM_delay_us(IN u4Byte	us)
+{
+	rtw_udelay_os(us);
+}
+
+VOID
+ODM_sleep_ms(IN u4Byte	ms)
