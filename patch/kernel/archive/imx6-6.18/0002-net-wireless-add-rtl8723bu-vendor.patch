+				case 0x08:
+					{
+						struct xmit_priv *pxmitpriv = &padapter->xmitpriv;
+						struct recv_priv  *precvpriv = &padapter->recvpriv;
+
+						DBG_871X("free_xmitbuf_cnt=%d, free_xmitframe_cnt=%d"
