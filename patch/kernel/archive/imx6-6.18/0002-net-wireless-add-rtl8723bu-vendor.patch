+# SPDX-License-Identifier: GPL-2.0-only
+config RTL8723BU_VENDOR
+    tristate "Realtek RTL8723BU USB WLAN (Benetti vendor driver)"
+    depends on USB && CFG80211
+    default m
+    help
+      Realtek RTL8723BU 802.11b/g/n USB adapter (0bda:b720), using the
+      Benetti-Engineering vendor driver. Builds 8723bu.ko. Intended for
+      NORCO EMB3501; this patch is applied only in the board patch series.
+
+      When enabled, RTL8XXXU is disabled to avoid conflicting USB binding.
