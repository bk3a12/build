index 0000000000000000000000000000000000000000..f45555f00cb36ee6a0c6e0046029481ff3178bbb
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8723bu/hal/odm_RTL8723B.c
@@ -0,0 +1,288 @@
+/******************************************************************************
