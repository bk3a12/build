+//	DBG_871X("+" FUNC_ADPT_FMT "\n", FUNC_ADPT_ARG(padapter));
+
+	if (NULL == buffer)
+	{
+		DBG_871X(FUNC_ADPT_FMT ": input buffer is NULL!\n",
