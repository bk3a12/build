diff --git a/drivers/net/wireless/realtek/rtl8723bu/include/ip.h b/drivers/net/wireless/realtek/rtl8723bu/include/ip.h
new file mode 100644
index 0000000000000000000000000000000000000000..d1af3c3d2cfaba3bbb6c744e93ef89bde302f608
