+		{
+			//	WFD primary sink + WiFi Direct mode + WSD (WFD Service Discovery)
+			val16 = pwfd_info->wfd_device_type | WFD_DEVINFO_WSD;
+			RTW_PUT_BE16(wfdie + wfdielen, val16);
