+//
+//	Description:
+//		Return TRUE if chTmp is represent for hex digit and
+//		FALSE otherwise.
+//
+//
+BOOLEAN
+IsHexDigit(
+	IN		char		chTmp
+)
+{
+	if( (chTmp >= '0' && chTmp <= '9') ||
+		(chTmp >= 'a' && chTmp <= 'f') ||
+		(chTmp >= 'A' && chTmp <= 'F') )
+	{
+		return _TRUE;
+	}
+	else
+	{
+		return _FALSE;
+	}
+}
+
+
+//
+//	Description:
+//		Translate a character to hex digit.
+//
+u32
+MapCharToHexDigit(
+	IN		char		chTmp
+)
+{
+	if(chTmp >= '0' && chTmp <= '9')
+		return (chTmp - '0');
+	else if(chTmp >= 'a' && chTmp <= 'f')
+		return (10 + (chTmp - 'a'));
+	else if(chTmp >= 'A' && chTmp <= 'F')
+		return (10 + (chTmp - 'A'));
+	else
+		return 0;
+}
