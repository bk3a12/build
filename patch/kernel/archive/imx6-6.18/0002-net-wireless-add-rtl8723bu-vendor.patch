+
+#ifdef CONFIG_CONCURRENT_MODE
+	if (rtw_buddy_adapter_up(padapter)) {
+		pbuddy_netdev = padapter->pbuddy_adapter->pnetdev;
+		if(pbuddy_netdev){
+			if (!rtw_netif_queue_stopped(pbuddy_netdev))
