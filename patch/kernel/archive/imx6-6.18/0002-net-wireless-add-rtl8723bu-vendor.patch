+
+	halbtc8723b1ant_PowerSaveState(pBtCoexist, BTC_PS_WIFI_NATIVE, 0x0, 0x0);
+
+	// tdma and coex table
+	if(BT_8723B_1ANT_BT_STATUS_ACL_BUSY == pCoexDm->btStatus) {
