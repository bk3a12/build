+void rtw_btcoex_RejectApAggregatedPacket(PADAPTER padapter, u8 enable)
+{
+	struct mlme_ext_info *pmlmeinfo;
+
+	pmlmeinfo = &padapter->mlmeextpriv.mlmext_info;
+
+	if (_TRUE == enable)
+	{
+		struct sta_info *psta = NULL;
+
+		pmlmeinfo->bAcceptAddbaReq = _FALSE;
+
+		if ((pmlmeinfo->state & 0x03) == WIFI_FW_STATION_STATE) {
+			psta = rtw_get_stainfo(&padapter->stapriv, get_bssid(&padapter->mlmepriv));
+			if (psta)
+				send_delba(padapter, 0, psta->hwaddr);
+		} else if ((pmlmeinfo->state & 0x03) == WIFI_FW_AP_STATE) {
+			_irqL irqL;
+			_list *phead, *plist;
+			u8 peer_num = 0;
+			char peers[NUM_STA];
+			struct sta_priv *pstapriv = &padapter->stapriv;
+			int i;
+
+			SPIN_LOCK_BH(pstapriv->asoc_list_lock, &irqL);
+
+			phead = &pstapriv->asoc_list;
+			plist = get_next(phead);
+
+			while ((rtw_end_of_queue_search(phead, plist)) == _FALSE) {
+				int stainfo_offset;
+
+				psta = LIST_CONTAINOR(plist, struct sta_info, asoc_list);
+				plist = get_next(plist);
+
+				stainfo_offset = rtw_stainfo_offset(pstapriv, psta);
+				if (stainfo_offset_valid(stainfo_offset))
+					peers[peer_num++] = stainfo_offset;
+			}
+
+			SPIN_UNLOCK_BH(pstapriv->asoc_list_lock, &irqL);
+
+			if (peer_num) {
+				for (i = 0; i < peer_num; i++) {
+					psta = rtw_get_stainfo_by_offset(pstapriv, peers[i]);
+					if (psta)
+						send_delba(padapter, 0, psta->hwaddr);
+				}
+			}
+		}
+	}
+	else
+	{
+		pmlmeinfo->bAcceptAddbaReq = _TRUE;
+	}
+}
