+	rtw_hal_set_chnl_bw(padapter, center_ch, bwmode, channel_offset,
+			    chnl_offset80); // set center channel
+
+	_exit_critical_mutex(&adapter_to_dvobj(padapter)->setch_mutex, NULL);
+}
