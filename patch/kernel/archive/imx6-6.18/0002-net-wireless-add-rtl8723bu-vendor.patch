index 0000000000000000000000000000000000000000..de36c18db0b7990cc972011896a20be7ead8a14a
--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8723bu/platform/platform_sprd_sdio.c
@@ -0,0 +1,80 @@
