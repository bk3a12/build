--- /dev/null
+++ b/drivers/net/wireless/realtek/rtl8723bu/Makefile
@@ -0,0 +1,369 @@
+INSTALL_FW_PATH = $(INSTALL_MOD_PATH)/lib/firmware
+FW_DIR	:= $(INSTALL_FW_PATH)/rtl_bt
