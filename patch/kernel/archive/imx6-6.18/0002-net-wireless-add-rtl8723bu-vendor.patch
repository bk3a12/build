+            {
+                while (v1 < 0x40000000 && i < ArrayLen-2) {
+                    odm_ConfigBB_PHY_8723B(pDM_Odm, v1, bMaskDWord, v2);
+                    READ_NEXT_PAIR(v1, v2, i);
