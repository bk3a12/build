+
+DEPMOD  = /sbin/depmod
+
+ccflags-y += $(USER_EXTRA_CFLAGS)
+ccflags-y += -O1
+#EXTRA_CFLAGS += -O3
+#EXTRA_CFLAGS += -Wall
+#EXTRA_CFLAGS += -Wextra
+#EXTRA_CFLAGS += -Werror
+#EXTRA_CFLAGS += -pedantic
