+int
+PHY_BBConfig8723B(IN PADAPTER Adapter)
+{
+	int	rtStatus = _SUCCESS;
+	HAL_DATA_TYPE	*pHalData = GET_HAL_DATA(Adapter);
+	u32	RegVal;
+	u8	TmpU1B = 0;
+	u8	value8, CrystalCap;
+
+	phy_InitBBRFRegisterDefinition(Adapter);
+
+	// Enable BB and RF
+	RegVal = rtw_read16(Adapter, REG_SYS_FUNC_EN);
+	rtw_write16(Adapter, REG_SYS_FUNC_EN, (u16)(RegVal|BIT13|BIT0|BIT1));
+
+	rtw_write32(Adapter, 0x948, 0x0);	// USB use Antenna S0
+
+	rtw_write8(Adapter, REG_RF_CTRL, RF_EN|RF_RSTB|RF_SDMRSTB);
+
+	rtw_usleep_os(10);
+
+	PHY_SetRFReg(Adapter, ODM_RF_PATH_A, 0x1, 0xfffff,0x780);
+
+	rtw_write8(Adapter, REG_SYS_FUNC_EN,
+		   FEN_PPLL|FEN_PCIEA|FEN_DIO_PCIE|FEN_BB_GLB_RSTn|FEN_BBRSTB);
+
+	rtw_write8(Adapter, REG_AFE_XTAL_CTRL + 1, 0x80);
+
+	//
+	// Config BB and AGC
+	//
+	rtStatus = phy_BB8723b_Config_ParaFile(Adapter);
+
+	// 0x2C[23:18] = 0x2C[17:12] = CrystalCap
+	CrystalCap = pHalData->CrystalCap & 0x3F;
+	PHY_SetBBReg(Adapter, REG_MAC_PHY_CTRL, 0xFFF000,
+		     (CrystalCap | (CrystalCap << 6)));
+
+	return rtStatus;
+}
