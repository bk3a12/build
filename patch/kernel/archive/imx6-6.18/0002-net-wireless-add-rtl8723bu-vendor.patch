+	*pPtr = rtw_zvmalloc(length);
+}
+
+// length could be ignored, used to detect memory leakage.
+VOID
+ODM_FreeMemory(
+	IN	PDM_ODM_T	pDM_Odm,
+	OUT	PVOID		pPtr,
+	IN	u4Byte		length
+	)
+{
+	rtw_vmfree(pPtr, length);
+}
